{
    "name": "dasintranet/dasintranet",
    "description": "DasIntranet framework application skeleton",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "dasintranet/framework": "^1.0.1"
    },
    "repositories": [
        {
            "type": "path",
            "url": "framework",
            "options": {
                "symlink": true,
                "versions": {
                    "dasintranet/framework": "1.0.1"
                }
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\Controllers\\": "app/controllers/"
        }
    }
}
